---
import ArticleCard from "./ArticleCard.astro";
import { formatArticlePublishedDate } from "../utils/helpers";
import type { IPost } from "../types/post";

const getPubDate = (post: string | any) =>
    new Date(post.frontmatter.pubDate || post.frontmatter.published).valueOf();

const allPosts = await Promise.all(Object.values(import.meta.glob("/src/pages/blog/**/*.{md,mdx}"))
    .map(async (item) => await item())
) as IPost[];

const filterFn = (post: IPost): boolean =>
    Boolean(post.frontmatter.pubDate || post.frontmatter.published);

const posts = allPosts
    .filter(filterFn)
    .sort((a, b) => getPubDate(b) - getPubDate(a));

// Multiples of 12 keep the standard 3-column grid hole-free (12 = featured + 2 secondary + 3×3).
const postsPerPage = 12;

const toCard = (post: IPost) => ({
    url: post.url,
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    formattedDate: formatArticlePublishedDate(post),
    image: post.frontmatter.heroImage,
});

const initialPosts = posts.slice(0, postsPerPage);
const remainingPosts = posts.slice(postsPerPage).map(toCard);

const variantForIndex = (index: number): "featured" | "secondary" | "standard" =>
    index === 0 ? "featured" : index <= 2 ? "secondary" : "standard";
---

<section class="col-span-full">
    <ul id="articles-list" class="grid grid-cols-1 md:grid-cols-6 gap-x-8 gap-y-12 mt-12 w-full border-t border-border pt-12">
        {
            initialPosts.map((post, index) => (
                <ArticleCard {...toCard(post)} variant={variantForIndex(index)} />
            ))
        }
    </ul>
    {
        remainingPosts.length > 0 && (
            <div class="mt-12">
                <button
                    id="load-more-button"
                    type="button"
                    class="focus-editorial group flex w-full items-center justify-center gap-3 border-y border-border py-5 text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:border-editorial hover:text-editorial"
                >
                    More articles
                    <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
                </button>
            </div>
        )
    }
</section>

<!-- Single source of truth for cards added by "More articles" -->
<template id="article-card-template">
    <ArticleCard url="" title="" description="" formattedDate="" variant="standard" />
</template>

<script define:vars={{ remainingPosts, postsPerPage }}>
    // Delegated + bound once so the handler survives view-transition navigation
    // (the button is replaced on every visit to the homepage). Pagination state
    // lives on the button's data attribute, so it also survives re-renders.
    if (!window.__loadMoreBound) {
        window.__loadMoreBound = true;

        document.addEventListener('click', (event) => {
            const button = event.target instanceof Element ? event.target.closest('#load-more-button') : null;
            const articlesList = document.getElementById('articles-list');
            const template = document.getElementById('article-card-template');
            if (!button || !articlesList || !(template instanceof HTMLTemplateElement)) return;

            const cursor = Number(button.dataset.cursor || 0);
            const nextPosts = remainingPosts.slice(cursor, cursor + postsPerPage);

            nextPosts.forEach((post) => {
                const clone = template.content.firstElementChild.cloneNode(true);
                clone.querySelector('[data-date]').textContent = post.formattedDate;
                clone.querySelector('[data-title]').textContent = post.title;
                clone.querySelector('[data-description]').textContent = post.description;
                clone.querySelector('a').setAttribute('href', post.url);
                articlesList.appendChild(clone);
            });

            const newCursor = cursor + nextPosts.length;
            if (newCursor >= remainingPosts.length) button.remove();
            else button.dataset.cursor = String(newCursor);
        });
    }
</script>
