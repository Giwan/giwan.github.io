---
import HeaderLink from "../HeaderLink.astro";
import links from "./headerLinks.json";
import HeaderNavMobile from "./HeaderNavMobile"; // jsx component
---

<nav id="navigation" aria-label="Main navigation">
    <!-- Desktop Navigation -->
    <div class="hidden sm:flex justify-end items-center rounded-sm gap-1">
        {
            links.map(({ href, label }, index) => (
                <HeaderLink
                    href={href}
                    class="font-medium text-foreground focus-editorial transition-colors duration-200 text-base"
                    aria-label={`Navigate to ${label}`}
                    style={`view-transition-name: nav-link-${label.toLowerCase().replace(/\s+/g, '-')};`}
                >
                    {label}
                </HeaderLink>
            ))
        }
    </div>

    <!-- Mobile Navigation -->
    <div class="sm:hidden">
        <HeaderNavMobile client:visible />
    </div>
</nav>
