---
export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href: rawHref, class: className, ...props } = Astro.props;
const href = String(rawHref ?? "");

const path =
    Astro.url.pathname.length > 1
        ? Astro.url.pathname.replace(/\/$/, "")
        : Astro.url.pathname;

const isActive = href === path || (path.indexOf(href) > -1 && href !== "/");
---

<a
    href={href}
    class:list={[
        "inline-block no-underline text-sm font-medium px-3 py-1 border-b-2 border-transparent transition-colors duration-200",
        "hover:text-editorial",
        { "border-editorial text-editorial font-semibold": isActive },
        className
    ]}
    aria-current={isActive ? "page" : undefined}
    {...props}
>
    <slot />
</a>